# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API). Placeholders only: never commit real values.
#
# IMPORTANT: every VITE_* variable is bundled into the browser build and is
# publicly visible. Only put public values here. NEVER use the service_role key,
# a "secret" key (sb_secret_...), or a database password.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...). If your project still uses the legacy
# "anon" key, put that key in this same variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
